{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oktech-sveltia-staging",
  "compatibility_date": "2026-09-01",
  "main": "workers/site/src/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    // Only uploads reach the Worker; everything else is served straight from `dist`.
    "run_worker_first": ["/uploads/*"],
  },
  // `bucket_name` is a placeholder. Wrangler does not interpolate environment variables, so
  // `npm run wrangler:config` writes the real name (MEDIA_BUCKET, or PUBLIC_R2_BUCKET) into
  // wrangler.generated.jsonc and the deploy uses that. Without a bucket it drops `main` and
  // this binding, and the site deploys as the assets-only Worker it was before.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "media-bucket-set-at-deploy" }],
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
}
