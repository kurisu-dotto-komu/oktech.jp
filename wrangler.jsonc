{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oktech-sveltia-staging",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
}
