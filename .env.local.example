# Local development configuration
# Copy this file to .env.local and customize as needed

# Server configuration
# Port for the development server (default: 4321)

# DEV_PORT=4321

# Port for the test server (optional - uses random port if not set)

# TEST_PORT=4322

# Base path for subdirectory deployment (optional)
# Examples:
# - For root deployment: leave blank
# - For github pages: BASE_PATH=/chris-wireframe

# BASE_PATH=/chris-wireframe

# Site URL (required in production)
# The full URL of your site without trailing slash
# Examples:
# - Production: SITE_URL=https://owddm.com
# - Staging: SITE_URL=https://myorg.github.io

# SITE_URL=https://owddm.com

# Stadia Maps API key, read at build time to stitch venue map tiles.
# Venues that already ship a committed map.jpg/map-dark.jpg do not need it.
# Get a free API key from: https://client.stadiamaps.com/signup/

# STADIA_MAPS_API_KEY=your_api_key_here

# ---------------------------------------------------------------------------
# PUBLIC_* variables
# These are inlined into the client bundle by Astro, so never put secrets here.
# ---------------------------------------------------------------------------

# Sveltia CMS (/admin) git backend
# Repository the CMS reads and commits to, as "owner/repo"
# Default: oktechjp/oktech.jp

# PUBLIC_CMS_REPO=your-user/oktech.jp

# Branch the CMS commits to
# Default: main

# PUBLIC_CMS_BRANCH=sveltia-cms

# Origin of the sveltia-cms-auth worker that performs the GitHub OAuth handshake
# Must be an origin only (no trailing path or slash)
# Default: https://auth.<STAGING_HOST> when STAGING_HOST is set, otherwise unset (no browser sign-in)

# PUBLIC_CMS_AUTH_BASE_URL=https://auth.staging.example.com

# Staging hostname used by `npm run deploy:staging` and as the base for the defaults above

# STAGING_HOST=staging.example.com

# Hostname of the media bucket; remote image URLs on this host are optimised by Astro at build time
# Default: images.<STAGING_HOST>

# IMAGES_HOST=images.staging.example.com

# Commit metadata shown in the footer (normally injected by CI, not set locally)

# PUBLIC_SOURCE_COMMIT_HASH=abc1234
# PUBLIC_SOURCE_COMMIT_URL=https://github.com/oktechjp/oktech.jp/commit/abc1234

# Cloudflare R2 media library for CMS uploads; all four are needed to enable it.
# The S3 secret access key is NOT configured here: each editor pastes it into the
# CMS settings (Media libraries → Cloudflare R2) in their browser.
# PUBLIC_IMAGES_URL defaults to https://<IMAGES_HOST>

# PUBLIC_R2_ACCOUNT_ID=your_cloudflare_account_id
# PUBLIC_R2_ACCESS_KEY_ID=your_r2_access_key_id
# PUBLIC_R2_BUCKET=your-bucket
# PUBLIC_IMAGES_URL=https://images.staging.example.com

# Origin of the upload Worker (optional). When set, the CMS signs uploads against this
# endpoint, which checks the signing key against its maintainer whitelist before writing
# to the bucket. When unset, uploads go straight to R2 with each editor's own key.

# PUBLIC_MEDIA_UPLOAD_ENDPOINT=https://uploads.staging.example.com
