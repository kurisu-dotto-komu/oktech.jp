---
import { type CollectionEntry, render } from "astro:content";

import Container from "@/components/Common/Container";
import type { MarkdownMeta } from "@/content/queries/markdown";
import PageLayout from "@/layouts/PageLayout.astro";

interface Props {
  entry: CollectionEntry<"pages">;
}

const { entry } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(entry);
const { readingTime } = remarkPluginFrontmatter as MarkdownMeta;
---

<PageLayout className="pt-32 pb-22">
  <Container thin>
    <div class="mb-12 flex flex-col items-start justify-between gap-8 sm:flex-row">
      <h1 class="title font-bold">{entry.data.title}</h1>
      {
        readingTime && (
          <div class="text-base-content/60 text-sm whitespace-nowrap">{readingTime}</div>
        )
      }
    </div>
    <div class="prose prose-lg max-w-none">
      <div class="prose prose-lg max-w-none"><Content /></div>
    </div>
  </Container>
</PageLayout>
