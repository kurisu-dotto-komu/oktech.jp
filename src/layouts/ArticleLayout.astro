---
import { type CollectionEntry, render } from "astro:content";
import { LuClock } from "react-icons/lu";

import ArticleAuthorBar from "@/components/Article/ArticleAuthorBar";
import ArticleNextLink from "@/components/Article/ArticleNextLink";
import Container from "@/components/Common/Container";
import { getArticles } from "@/content";
import type { MarkdownMeta } from "@/content/queries/markdown";
import PageLayout from "@/layouts/PageLayout.astro";
import { parseAuthor } from "@/utils/author";
import { cmsEditHref } from "@/utils/cms";

interface Props {
  entry: CollectionEntry<"articles">;
}

const { entry } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(entry);
const { readingTime } = remarkPluginFrontmatter as MarkdownMeta;

const author = entry.data.author ? parseAuthor(entry.data.author) : undefined;

// The next article is the next older one, in the same order the listing uses.
const articles = await getArticles();
const next = articles[articles.findIndex((article) => article.id === entry.id) + 1];

function formatDate(dateStr: string): string {
  const d = new Date(dateStr);
  return d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
}
---

<PageLayout className="pt-32 pb-22" cmsHref={cmsEditHref("articles", entry.id)}>
  <Container thin>
    <div class="mb-20 flex flex-col gap-4">
      <h1 class="title">{entry.data.title}</h1>
      {
        (author || entry.data.date || readingTime) && (
          <div class="text-base-content/60 flex flex-wrap items-center gap-2 text-sm">
            {author && <ArticleAuthorBar author={author} />}
            {author && (entry.data.date || readingTime) && (
              <span class="text-base-content/30">&middot;</span>
            )}
            {entry.data.date && (
              <span class="flex items-center gap-1">
                <LuClock className="h-3.5 w-3.5" />
                {formatDate(entry.data.date)}
              </span>
            )}
            {entry.data.date && readingTime && <span class="text-base-content/30">&middot;</span>}
            {readingTime && <span>{readingTime}</span>}
          </div>
        )
      }
    </div>
    <div class="prose prose-lg max-w-none">
      <div class="prose prose-lg max-w-none"><Content /></div>
    </div>
    <ArticleNextLink title={next?.title} href={next?.href} />
  </Container>
</PageLayout>
