---
// Sveltia CMS admin page. Configuration lives in src/cms/.
import { Font } from "astro:assets";

import { SITE } from "@/constants";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <title>{SITE.shortName} CMS</title>
    {
      /* Emits the site's @font-face rules; src/cms/previews/styles.ts copies them into the
    preview iframe, which cannot link them because their family name is build-specific. */
    }
    <Font cssVariable="--font-lexend" />
    <style is:global>
      /*
       * Sveltia prints a "(+09:00) Tokyo" chip beside every datetime input whose field sets
       * `input_timezone`. It is rendered unconditionally — there is no option to turn it off —
       * so it is hidden here instead; the field's own label and hint already say Japan Time.
       * The element carries a build-specific Svelte scope class, so only `.timezone` is matched.
       */
      .field-wrapper .timezone {
        display: none;
      }
    </style>
  </head>
  <body>
    <script>
      import { bootstrapMediaUploads } from "@/cms/bootstrap";
      import { buildCmsConfig } from "@/cms/config";
      import { registerPreviews } from "@/cms/previews";
      import MarkdownEditorControl from "@/cms/widgets/markdownEditor";
      import { MARKDOWN_WIDGET, PULL_REQUEST_WIDGET } from "@/cms/widgets/names";
      import PullRequestControl from "@/cms/widgets/pullRequest";

      const config = buildCmsConfig();

      // Before the import below, not after: @sveltia/cms reads the stored preferences into
      // reactive state as its modules evaluate, so the upload credential has to be in
      // `localStorage` by then. The widgets are safe to import statically — they only take
      // types from the CMS package.
      await bootstrapMediaUploads(config);

      const { default: CMS } = await import("@sveltia/cms");

      CMS.registerWidget(PULL_REQUEST_WIDGET, PullRequestControl);
      CMS.registerWidget(MARKDOWN_WIDGET, MarkdownEditorControl);
      registerPreviews(CMS);
      CMS.init({ config });
    </script>
  </body>
</html>
