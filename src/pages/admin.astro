---
// Sveltia CMS Admin Page
// This page serves Sveltia CMS for local content management
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sveltia CMS - OKTech</title>
  </head>
  <body>
    <script>
      import CMS from "@sveltia/cms";

      CMS.init({
        config: {
          load_config_file: false,
          backend: {
            name: "github",
            repo: "oktechjp/oktech.jp",
            branch: "main",
          },
          media_folder: "/content",
          public_folder: "/content",
          collections: [
            {
              name: "events",
              label: "Events",
              label_singular: "Event",
              folder: "/content/events",
              path: "{{slug}}/event",
              media_folder: "",
              public_folder: "",
              create: true,
              slug: "{{fields.meetupId}}-{{fields.title | slugify}}",
              summary: "{{title}} - {{dateTime}}",
              sortable_fields: ["dateTime", "title", "meetupId"],
              fields: [
                {
                  name: "title",
                  label: "Title",
                  widget: "string",
                  required: true,
                },
                {
                  name: "dateTime",
                  label: "Date & Time",
                  widget: "datetime",
                  format: "YYYY-MM-DD HH:mm",
                  date_format: "YYYY-MM-DD",
                  time_format: "HH:mm",
                  required: true,
                },
                {
                  name: "duration",
                  label: "Duration (minutes)",
                  widget: "number",
                  value_type: "int",
                  min: 15,
                  default: 120,
                },
                {
                  name: "cover",
                  label: "Cover Image",
                  widget: "image",
                  required: true,
                },
                {
                  name: "meetupId",
                  label: "Meetup ID",
                  widget: "number",
                  value_type: "int",
                  required: true,
                },
                {
                  name: "venue",
                  label: "Venue",
                  widget: "relation",
                  collection: "venues",
                  value_field: "meetupId",
                  display_fields: ["title", "city"],
                  search_fields: ["title", "city", "address"],
                  required: false,
                },
                {
                  name: "group",
                  label: "Group ID",
                  widget: "number",
                  value_type: "int",
                  required: false,
                },
                {
                  name: "topics",
                  label: "Topics",
                  widget: "select",
                  multiple: true,
                  required: false,
                  options: [
                    "AI and Society",
                    "AI/ML",
                    "Business",
                    "Computer Programming",
                    "Container Security",
                    "DevOps",
                    "HTML & CSS",
                    "Interactive Art",
                    "Internet Professionals",
                    "New Technology",
                    "Open Source",
                    "ReactJS",
                    "Socializing",
                    "Software Development",
                    "Software Security",
                    "UI/UX Design",
                    "Web Design",
                    "Web Development",
                    "Web3",
                  ],
                },
                {
                  name: "howToFindUs",
                  label: "How to Find Us",
                  widget: "text",
                  required: false,
                },
                {
                  name: "links",
                  label: "Links",
                  widget: "keyvalue",
                  required: false,
                },
                {
                  name: "isCancelled",
                  label: "Cancelled",
                  widget: "boolean",
                  default: false,
                },
                {
                  name: "devOnly",
                  label: "Dev Only (Hidden in Production)",
                  widget: "boolean",
                  default: false,
                },
                {
                  name: "body",
                  label: "Description",
                  widget: "markdown",
                  required: false,
                },
              ],
            },
            {
              name: "venues",
              label: "Venues",
              label_singular: "Venue",
              folder: "/content/venues",
              path: "{{slug}}/venue",
              media_folder: "",
              public_folder: "",
              create: true,
              slug: "{{fields.meetupId}}-{{fields.title | slugify}}",
              summary: "{{title}} - {{city}}",
              sortable_fields: ["title", "city", "meetupId"],
              fields: [
                {
                  name: "title",
                  label: "Venue Name",
                  widget: "string",
                  required: true,
                },
                {
                  name: "meetupId",
                  label: "Meetup Venue ID",
                  widget: "number",
                  value_type: "int",
                  required: true,
                },
                {
                  name: "city",
                  label: "City",
                  widget: "string",
                  required: false,
                },
                {
                  name: "country",
                  label: "Country",
                  widget: "string",
                  required: false,
                  default: "Japan",
                },
                {
                  name: "address",
                  label: "Address",
                  widget: "string",
                  required: false,
                },
                {
                  name: "state",
                  label: "State/Prefecture",
                  widget: "string",
                  required: false,
                },
                {
                  name: "postalCode",
                  label: "Postal Code",
                  widget: "string",
                  required: false,
                },
                {
                  name: "url",
                  label: "Website URL",
                  widget: "string",
                  required: false,
                },
                {
                  name: "gmaps",
                  label: "Google Maps URL",
                  widget: "string",
                  required: false,
                },
                {
                  name: "location",
                  label: "Location",
                  widget: "map",
                  required: false,
                },
                {
                  name: "hasPage",
                  label: "Has Dedicated Page",
                  widget: "boolean",
                  default: false,
                },
                {
                  name: "devOnly",
                  label: "Dev Only (Hidden in Production)",
                  widget: "boolean",
                  default: false,
                },
                {
                  name: "cover",
                  label: "Cover Image",
                  widget: "image",
                  required: false,
                },
                {
                  name: "body",
                  label: "Description",
                  widget: "markdown",
                  required: false,
                },
              ],
            },
            {
              name: "articles",
              label: "Articles",
              label_singular: "Article",
              folder: "/content/articles",
              create: true,
              slug: "{{slug}}",
              summary: "{{title}}",
              fields: [
                {
                  name: "title",
                  label: "Title",
                  widget: "string",
                  required: true,
                },
                {
                  name: "description",
                  label: "Description",
                  widget: "text",
                  required: false,
                },
                {
                  name: "keywords",
                  label: "Keywords",
                  widget: "list",
                  required: false,
                  field: {
                    name: "keyword",
                    label: "Keyword",
                    widget: "string",
                  },
                },
                {
                  name: "body",
                  label: "Content",
                  widget: "markdown",
                  required: true,
                },
              ],
            },
          ],
        },
      });
    </script>
  </body>
</html>
