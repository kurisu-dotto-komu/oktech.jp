---
// Sveltia CMS admin page. Configuration lives in src/cms/.
import { Font } from "astro:assets";

import { SITE } from "@/constants";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <title>{SITE.shortName} CMS</title>
    {
      /* Emits the site's @font-face rules; src/cms/previews/styles.ts copies them into the
    preview iframe, which cannot link them because their family name is build-specific. */
    }
    <Font cssVariable="--font-lexend" />
    <style is:global>
      /*
       * Sveltia prints a "(+09:00) Tokyo" chip beside every datetime input whose field sets
       * `input_timezone`. It is rendered unconditionally — there is no option to turn it off —
       * so it is hidden here instead; the field's own label and hint already say Japan Time.
       * The element carries a build-specific Svelte scope class, so only `.timezone` is matched.
       */
      .field-wrapper .timezone {
        display: none;
      }

      /*
       * The thumbnail src/cms/fieldThumbnails.ts puts into an image field whose value is a
       * `cloudflare:/<key>` reference, in place of the document icon Sveltia falls back to.
       * Both rules key off the attribute that module sets, so a box it has not touched keeps
       * Sveltia's own appearance.
       */
      .preview[data-cms-thumbnail] > .icon {
        display: none;
      }

      .preview[data-cms-thumbnail] > img[data-cms-thumbnail] {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
      }

      /* The post-save pull request bar. The site's Tailwind build is not loaded here, so
         these are the only styles src/cms/notice.ts has to work with. */
      .cms-notice {
        position: fixed;
        inset-inline: 0;
        bottom: 0;
        z-index: 100;
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        align-items: center;
        justify-content: center;
        padding: 12px 16px;
        background: var(--sui-secondary-background-color, #222);
        color: var(--sui-primary-foreground-color, #fff);
        font-family: var(--sui-font-family-default, system-ui, sans-serif);
        font-size: var(--sui-font-size-small, 14px);
      }

      .cms-notice a {
        color: inherit;
      }

      .cms-notice button {
        border: 1px solid currentColor;
        border-radius: 4px;
        padding: 2px 10px;
        background: none;
        color: inherit;
        cursor: pointer;
        font: inherit;
      }
    </style>
  </head>
  <body>
    <script>
      import { bootstrapMediaUploads } from "@/cms/bootstrap";
      import { buildCmsConfig } from "@/cms/config";
      import { registerCmsEvents } from "@/cms/events";
      import { registerFieldThumbnails } from "@/cms/fieldThumbnails";
      import { registerPreviews } from "@/cms/previews";
      import { registerRequiredFields } from "@/cms/requiredFields";
      import MarkdownEditorControl from "@/cms/widgets/markdownEditor";
      import { MARKDOWN_WIDGET, PULL_REQUEST_WIDGET } from "@/cms/widgets/names";
      import PullRequestControl from "@/cms/widgets/pullRequest";
      import { registerUploadRefs } from "@/cms/uploadRefs";

      const config = buildCmsConfig();

      // Before the import below, not after: @sveltia/cms reads the stored preferences into
      // reactive state as its modules evaluate, so the upload credential has to be in
      // `localStorage` by then. The widgets are safe to import statically — they only take
      // types from the CMS package.
      await bootstrapMediaUploads(config);

      const { default: CMS } = await import("@sveltia/cms");

      CMS.registerWidget(PULL_REQUEST_WIDGET, PullRequestControl);
      CMS.registerWidget(MARKDOWN_WIDGET, MarkdownEditorControl);
      registerPreviews(CMS);
      registerCmsEvents(CMS);
      // Before the rewrite: an entry that is not going to be saved is not worth rewriting.
      registerRequiredFields(CMS, config);
      registerUploadRefs(CMS);
      registerFieldThumbnails();
      CMS.init({ config });
    </script>
  </body>
</html>
